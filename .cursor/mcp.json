{
  "mcpServers": {
    "rosetta": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/bun",
      "args": [
        "run",
        "${workspaceFolder}/vendor/rosetta/src/mcp.ts"
      ],
      "env": {
        "DB_PATH": "${workspaceFolder}/.cache/rosetta/ros-help.db",
        "ROSETTA_OFFLINE": "1"
      }
    },
    "mikrotik-readonly": {
      "type": "stdio",
      "command": "${workspaceFolder}/tools/run-mikrotik-mcp-hardened.sh",
      "args": [],
      "env": {
        "MIKROTIK_INVENTORY_FILE": "${userHome}/.config/mikrobackups/inventory.yml",
        "MIKROTIK_KNOWN_HOSTS_PATH": "${userHome}/.ssh/mikrobackups/known_hosts",
        "MIKROTIK_PROFILE": "hardened-read-only",
        "MIKROTIK_READ_ONLY": "true",
        "MIKROTIK_SENSITIVE_HIDING": "true",
        "MIKROTIK_MCP__TRANSPORT": "stdio"
      }
    }
  }
}
